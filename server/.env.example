# ─── Kidzvi Backend Environment Variables — EXAMPLE ───────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to version control.

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development         # development | production | test

# ─── Database ──────────────────────────────────────────────────────────────────
# Local MongoDB
MONGO_URI=mongodb://localhost:27017/kidzvi

# MongoDB Atlas (production)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/kidzvi?retryWrites=true&w=majority

# ─── Authentication ────────────────────────────────────────────────────────────
# Use a long, random string in production (e.g., generated with: openssl rand -hex 64)
JWT_SECRET=your_super_secret_jwt_key_here_change_me_in_production
JWT_EXPIRES_IN=7d            # Token expiry: e.g., 1d, 7d, 30d

# ─── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173   # Vite/React frontend URL
